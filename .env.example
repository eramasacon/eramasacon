# Copy to .env.local (local) and add the same values on your hosting provider.

# Resend – https://resend.com/api-keys  (keep this secret, never commit it)
RESEND_API_KEY=
# Sender address: must be on a domain verified in Resend (Domains → eramasacon.com)
EMAIL_FROM="Eram Asacon <noreply@eramasacon.com>"
# Inbox that receives contact form enquiries and profile-request leads
CONTACT_TO=info@eramasacon.com

# SEO: set to true only on the live site so search engines may index it
SITE_INDEXING=
# Public site URL used for canonical links, sitemap and email links
NEXT_PUBLIC_SITE_URL=https://eramasacon.com
